# 项目基础设置
ENV=development
LOG_LEVEL=DEBUG
APP_CONFIG_FILEPATH=config.yaml

# 数据库相关的配置
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/manus

# Redis相关配置
REDIS_HOST=localhost
REDIS_PORT=8001
REDIS_DB=0
REDIS_PASSWORD=

# OSS对象存储配置
OSS_BASE_URL=http://your-oss.com/lh-oss/uploadFile
OSS_BUCKET=

# 沙箱配置
SANDBOX_ADDRESS=
SANDBOX_IMAGE=sandbox:latest
SANDBOX_NAME_PREFIX=sandbox
# 容器内supervisord服务超时(分钟),传给沙箱容器作为SERVICE_TIMEOUT_MINUTES
SANDBOX_TTL_MINUTES=60
# 沙箱空闲销毁TTL(秒): 会话结束后沙箱保留时长,超时自动销毁;TTL内续接会话可复用沙箱。默认2小时(7200秒)
SANDBOX_IDLE_TTL_SECONDS=7200
SANDBOX_NETWORK=IDO-network
SANDBOX_CHROME_ARGS=
SANDBOX_HTTPS_PROXY=
SANDBOX_HTTP_PROXY=
SANDBOX_NO_PROXY=

# MCP多模态服务配置
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MULTIMODAL_VL_MODEL=glm-4.6v
MULTIMODAL_IMAGE_MODEL=cogview-4
MULTIMODAL_ASR_MODEL=glm-asr-2512
